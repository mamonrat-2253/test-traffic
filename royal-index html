            [chatBtn, planBtn, drawBtn].forEach(b => {
                if (b) b.className = "py-1 px-1 rounded-lg text-[11px] font-bold font-traditional text-neutral-500 hover:text-thaiBlack transition-all";
            });
            [chatPanel, planPanel, drawPanel].forEach(p => {
                if (p) p.classList.add('hidden');
            });

            if (subTab === 'chat') {
                chatBtn.className = "py-1 px-1 rounded-lg text-[11px] font-bold font-traditional bg-royalGoldLight text-royalGoldDark transition-all";
                chatPanel.classList.remove('hidden');
            } else if (subTab === 'plan') {
                planBtn.className = "py-1 px-1 rounded-lg text-[11px] font-bold font-traditional bg-royalGoldLight text-royalGoldDark transition-all";
