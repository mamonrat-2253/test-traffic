    <!-- Google Fonts: Charmonman & Charm (Traditional Thai script matching IMG_20260712_072854.jpg) and Sarabun (Formal body text) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Charm:wght@400;700&family=Charmonman:wght@400;700&family=Sarabun:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Font Awesome for clean, sharp icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        royalGold: '#C5A059',       // Elegant traditional Thai gold
                        royalGoldDark: '#9A7B3E',   // Deep bronze gold accent
                        royalGoldLight: '#F3EAD3',  // Pale gold ivory
                        thaiYellow: '#FCD116',      // State golden yellow
                        thaiWhite: '#FFFFFF',       // Clean white
                        thaiCream: '#FCFBF7',       // Sovereign parchment cream
                        thaiBlack: '#111111',       // High-contrast rich black for formal text
                        thaiMuted: '#555555',       // Charcoal for subtle notes
                    },
                    fontFamily: {
                        traditional: ['Charmonman', 'Charm', 'serif'],
                        formal: ['Sarabun', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    
    <style>
        body {
            font-family: 'Sarabun', 'sans-serif';
            background: linear-gradient(135deg, #F3EAD3 0%, #FCFBF7 100%);
            color: #111111;
            overscroll-behavior: contain;
        }
        
        .font-traditional {
            font-family: 'Charmonman', 'Charm', serif;
        }
        
        /* Custom scrollbar matching formal gold theme */
        .custom-scrollbar::-webkit-scrollbar {
            width: 5px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: #FCFBF7;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #C5A059;
            border-radius: 9999px;
        }
        
        /* Slow elegant shaking animation for the grievance bell */
        @keyframes formal-bell {
            0%, 100% { transform: rotate(0); }
            10% { transform: rotate(8deg); }
            20% { transform: rotate(-7deg); }
            30% { transform: rotate(6deg); }
            40% { transform: rotate(-5deg); }
            50% { transform: rotate(4deg); }
            60% { transform: rotate(-3deg); }
            70% { transform: rotate(2deg); }
            80% { transform: rotate(-1deg); }
        }
        .animate-formal-bell {
            animation: formal-bell 1.5s ease-in-out infinite;
            transform-origin: top center;
        }

        /* Sovereign Royal Thai Flag Ribbon decoration */
        .flag-accent-bar {
            height: 4px;
            background: linear-gradient(to right, 
                #A22226 0%, #A22226 18%, 
                #F4F5F8 18%, #F4F5F8 36%, 
                #1B2244 36%, #1B2244 64%, 
                #F4F5F8 64%, #F4F5F8 82%, 
                #A22226 82%, #A22226 100%
            );
        }
        
        /* Golden Filigree Border Decoration */
        .royal-border {
            position: relative;
            border: 1px solid rgba(197, 160, 89, 0.4);
        }
        .royal-border::before {
            content: '';
            position: absolute;
            top: 2px;
            left: 2px;
            right: 2px;
            bottom: 2px;
            border: 1px solid rgba(197, 160, 89, 0.2);
            pointer-events: none;
            border-radius: inherit;
        }
    </style>
</head>
