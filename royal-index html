        // Generate dynamic historical grievance using gemini-3-flash-preview structured output
        async function generateAiGrievance(category) {
            const systemPrompt = `คุณคือ 'ระบบจำลองประวัติศาสตร์ไทยและศาสตร์พระราชา' หน้าที่ของคุณคือการสร้างกรณีศึกษาหรือฎีกาจำลองจากปวงชนชาวไทยในยุคประวัติศาสตร์หรือปัญหาเกษตรกรรม/สิ่งแวดล้อมปัจจุบัน เพื่อให้ผู้เรียนได้คิดวิเคราะห์หาวิธีแก้ไขโดยประยุกต์ใช้หลัก 'ศาสตร์พระราชา' (เช่น โครงการแก้มลิง, แกล้งดิน, เศรษฐกิจพอเพียง, โครงการหลวง, ฝายชะลอน้ำ) ปัญหาต้องถูกสร้างตามหมวดหมู่ที่ระบุ และสร้างตัวเลือก 3 ตัวเลือก โดยมีเพียง 1 ตัวเลือกที่เหมาะสมที่สุดที่สะท้อนการแก้ปัญหาตามศาสตร์พระราชา และอีก 2 ตัวเลือกต้องเป็นทางเลือกที่ไม่ยั่งยืนหรือผิดหลักการแก้ไขปัญหาตามภูมิสังคม`;
            
            const categoryTrans = {
                water: "การบริหารจัดการน้ำ (น้ำท่วม, น้ำแล้ง หรือน้ำเน่าเสีย)",
                soil: "การปรับปรุงบำรุงผืนดิน (ดินเปรี้ยว, ดินเค็ม หรือดินจืดปลูกอะไรไม่ขึ้น)",
                forest: "ป่าต้นน้ำและการตัดไม้ทำลายป่า (ไฟป่า, ไร่เลื่อนลอย หรือความแห้งแล้งบนเขาสูง)",
                livelihood: "ชีวิตความเป็นอยู่และความยากจน (หนี้นอกระบบ, พืชผลตกต่ำ หรือไร้ที่ดินทำกิน)"
            };

            const userQuery = `โปรดสร้างคดีความเดือดร้อนประเภท: ${categoryTrans[category]} คดีต้องมีความสมจริง น่าสนใจ อิงเรื่องเล่าในประวัติศาสตร์ไทยหรือสังคมไทยแบบร่วมสมัย และสร้างตัวเลือกในการบำบัดทุกข์บำรุงสุข 3 ข้อ พร้อมผลลัพธ์ป้อนกลับ (Feedback)`;

            const apiKey = "";
            const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=${apiKey}`;

            const payload = {
                contents: [{ parts: [{ text: userQuery }] }],
                systemInstruction: {
                    parts: [{ text: systemPrompt }]
                },
                generationConfig: {
                    responseMimeType: "application/json",
                    responseSchema: {
                        type: "OBJECT",
                        properties: {
                            caseTitle: { type: "STRING" },
                            caseDesc: { type: "STRING" },
                            choices: {
                                type: "ARRAY",
                                items: {
                                    type: "OBJECT",
                                    properties: {
                                        text: { type: "STRING" },
                                        correct: { type: "BOOLEAN" },
                                        feedback: { type: "STRING" }
                                    },
                                    required: ["text", "correct", "feedback"]
                                }
                            }
                        },
                        required: ["caseTitle", "caseDesc", "choices"]
                    }
                }
            };

            // Implement exponential backoff when making API calls to handle potential throttling
            let delay = 1000;
            for (let i = 0; i < 3; i++) {
                try {
                    const response = await fetch(apiUrl, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });
                    if (response.ok) {
                        const result = await response.json();
                        const jsonText = result?.candidates?.[0]?.content?.parts?.[0]?.text;
                        if (jsonText) {
                            return JSON.parse(jsonText);
                        }
                    } else if (response.status === 429) {
                        await new Promise(resolve => setTimeout(resolve, delay));
                        delay *= 2;
                    }
                } catch (e) {
                    await new Promise(resolve => setTimeout(resolve, delay));
                    delay *= 2;
                }
            }
            return null;
        }

        // Submit Choice handlers
        function submitCaseChoice(choiceIndex) {
            const currentCase = gameCases.find(c => c.id === AppState.currentGame.activeCaseId);
            if (!currentCase) return;

            const chosen = currentCase.choices[choiceIndex];
            renderGameFeedback(chosen.correct, chosen.feedback);
        }

        function submitAiCaseChoice(choiceIndex) {
            const chosen = AppState.currentGame.activeAiChoices[choiceIndex];
            if (!chosen) return;
            renderGameFeedback(chosen.correct, chosen.feedback);
        }

        function renderGameFeedback(isCorrect, feedbackText) {
            const caseStudyBox = document.getElementById('caseStudyBox');
            const gameFeedback = document.getElementById('gameFeedback');
            const feedbackIcon = document.getElementById('gameFeedbackIcon');
            const feedbackTitle = document.getElementById('gameFeedbackTitle');
            const feedbackDesc = document.getElementById('gameFeedbackDesc');

            caseStudyBox.classList.add('hidden');
            gameFeedback.classList.remove('hidden');

            if (isCorrect) {
                addStars(25);
                feedbackIcon.className = "text-5xl text-royalGold";
                feedbackIcon.innerHTML = '<i class="fa-solid fa-crown text-royalGoldDark"></i>';
                feedbackTitle.textContent = "บำบัดทุกข์บำรุงสุขสำเร็จ!";
                feedbackTitle.className = "text-xl font-bold font-traditional text-thaiBlack";
