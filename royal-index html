        // Query Gemini Text with Exponential Backoff
        async function getGeminiTutorReply(userMsg) {
            const systemInstruction = "คุณคือ 'ติวเตอร์ศาสตร์พระราชาและสถาบันกษัตริย์' หน้าที่ของคุณคือการตอบคำถามให้ข้อมูลความรู้เกี่ยวกับความเป็นมาประวัติศาสตร์ไทย, ความสำคัญของสถาบันพระมหากษัตริย์ในสังคมไทย, ทศพิธราชธรรม, และโครงการอันเนื่องมาจากพระราชดำริทุกประเภท (เช่น แกล้งดิน แก้มลิง ฝนหลวง ปรัชญาเศรษฐกิจพอเพียง) อธิบายด้วยความสุภาพ นอบน้อม ใช้ภาษาไทยที่สละสลวยถูกต้อง เหมาะสม และเข้าใจง่าย กระชับ เหมาะกับการอ่านบนหน้าจอสมาร์ทโฟน";
            
            // Build temporary memory for context
            AppState.tutorChatHistory.push({ role: "user", parts: [{ text: userMsg }] });
            if (AppState.tutorChatHistory.length > 10) {
                AppState.tutorChatHistory.shift(); // Keep context window under 10 turns
            }

            const apiKey = "";
            const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=${apiKey}`;

            const payload = {
                contents: AppState.tutorChatHistory,
                systemInstruction: {
                    parts: [{ text: systemInstruction }]
                }
            };

            let delay = 1000;
            const maxRetries = 3;

            for (let attempt = 0; attempt < maxRetries; attempt++) {
                try {
                    const response = await fetch(apiUrl, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });

                    if (response.ok) {
                        const data = await response.json();
                        const responseText = data?.candidates?.[0]?.content?.parts?.[0]?.text;
                        if (responseText) {
                            AppState.tutorChatHistory.push({ role: "model", parts: [{ text: responseText }] });
                            return responseText;
                        }
                    } else if (response.status === 429) {
                        // Throttling error - engage exponential backoff
                        await new Promise(resolve => setTimeout(resolve, delay));
                        delay *= 2;
                    } else {
                        throw new Error(`HTTP error code: ${response.status}`);
                    }
                } catch (e) {
                    if (attempt === maxRetries - 1) {
                        return "ขอประทานอภัยอย่างยิ่งครับ ระบบการสืบค้นปัญญาประดิษฐ์เกิดการขัดข้องทางเทคนิคชั่วคราว กรุณาลองสอบถามใหม่อีกครั้งในภายหลังนะครับ";
                    }
                    await new Promise(resolve => setTimeout(resolve, delay));
                    delay *= 2;
                }
            }
            return "ไม่สามารถเชื่อมต่อติวเตอร์ได้ในขณะนี้";
        }

        // Call gemini-2.5-flash-preview-tts model to synthesize raw PCM and construct WAV blob
        async function speakText(btn, rawText) {
            // Put btn in loading state
            const origHTML = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = `<i class="fa-solid fa-spinner animate-spin"></i> กำลังพากย์...`;

            // Clean up text formatting to avoid strange TTS artifacts
            const cleanText = rawText.replace(/[*#_\-`]/g, '').trim();
            const formattedPrompt = `พูดภาษาไทยข้อความนี้ด้วยน้ำเสียงสุภาพ นุ่มนวล ชัดเจน และน่าฟัง: ${cleanText}`;

            const payload = {
                contents: [{
                    parts: [{ text: formattedPrompt }]
                }],
                generationConfig: {
                    responseModalities: ["AUDIO"],
                    speechConfig: {
                        voiceConfig: {
                            prebuiltVoiceConfig: { voiceName: "Sadachbia" } // Lively friendly voice
                        }
                    }
                }
            };

            const apiKey = "";
            const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-preview-tts:generateContent?key=${apiKey}`;

            try {
                const response = await fetch(apiUrl, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                if (!response.ok) throw new Error("TTS fetch failure");

                const result = await response.json();
                const part = result?.candidates?.[0]?.content?.parts?.[0];
                const base64Audio = part?.inlineData?.data;
                const mimeType = part?.inlineData?.mimeType;

                if (base64Audio && mimeType && mimeType.startsWith("audio/")) {
                    const sampleRateMatch = mimeType.match(/rate=(\d+)/);
                    const sampleRate = sampleRateMatch ? parseInt(sampleRateMatch[1], 10) : 24000;

                    const pcmData = base64ToArrayBuffer(base64Audio);
                    const pcm16 = new Int16Array(pcmData);
                    const wavBlob = pcmToWav(pcm16, sampleRate);
                    const audioUrl = URL.createObjectURL(wavBlob);

                    // Play WAV file
                    const audio = new Audio(audioUrl);
                    audio.play();

                    btn.innerHTML = `<i class="fa-solid fa-circle-play text-royalGoldDark animate-pulse"></i> กำลังพูด...`;
                    audio.onended = () => {
                        btn.disabled = false;
                        btn.innerHTML = origHTML;
                    };
                } else {
                    throw new Error("Invalid audio response");
                }
            } catch (e) {
                console.error("Gemini TTS engine error", e);
                btn.disabled = false;
                btn.innerHTML = `<i class="fa-solid fa-times text-red-500"></i> ล้มเหลว`;
                setTimeout(() => { btn.innerHTML = origHTML; }, 2000);
            }
        }

        function base64ToArrayBuffer(base64) {
            const binaryString = window.atob(base64);
            const len = binaryString.length;
            const bytes = new Uint8Array(len);
            for (let i = 0; i < len; i++) {
                bytes[i] = binaryString.charCodeAt(i);
            }
            return bytes.buffer;
        }

        function pcmToWav(pcm16Array, sampleRate) {
            const buffer = new ArrayBuffer(44 + pcm16Array.byteLength);
            const view = new DataView(buffer);

            // RIFF chunk identifier
            writeString(view, 0, 'RIFF');
            // file length (total pcm size + 36 bytes)
            view.setUint32(4, 36 + pcm16Array.byteLength, true);
            // RIFF type
            writeString(view, 8, 'WAVE');
            // format chunk identifier
            writeString(view, 12, 'fmt ');
            // format chunk length
            view.setUint32(16, 16, true);
            // sample format (1 = raw signed PCM)
            view.setUint16(20, 1, true);
            // channel count (1 = mono)
            view.setUint16(22, 1, true);
            // sample rate
            view.setUint32(24, sampleRate, true);
            // byte rate (sample rate * block align)
            view.setUint32(28, sampleRate * 2, true);
            // block align (channel count * bytes per sample)
            view.setUint16(32, 2, true);
            // bits per sample (16 bit pcm)
            view.setUint16(34, 16, true);
            // data chunk identifier
            writeString(view, 36, 'data');
            // data chunk length
            view.setUint32(40, pcm16Array.byteLength, true);

            // Write PCM audio samples
            const pcmView = new DataView(pcm16Array.buffer);
            for (let i = 0; i < pcm16Array.length; i++) {
                view.setInt16(44 + i * 2, pcmView.getInt16(i * 2, true), true);
            }

            return new Blob([view], { type: 'audio/wav' });
        }

        function writeString(view, offset, string) {
            for (let i = 0; i < string.length; i++) {
                view.setUint8(offset + i, string.charCodeAt(i));
            }
        }

