            const caseStudyDesc = document.getElementById('caseStudyDesc');
            const caseStudyOptions = document.getElementById('caseStudyOptions');
            const gameFeedback = document.getElementById('gameFeedback');
            const aiLoading = document.getElementById('aiGameLoading');

            gameFeedback.classList.add('hidden');
            caseStudyBox.classList.add('hidden');

            if (AppState.currentGame.mode === 'ai') {
                // Call Gemini API to generate dynamic historical case
                aiLoading.classList.remove('hidden');
                document.getElementById('appMain').scrollTop = 180;

                const caseDetails = await generateAiGrievance(AppState.currentGame.aiCategory);
                aiLoading.classList.add('hidden');

                if (!caseDetails) {
                    // Fallback to classic game if AI fails
                    setGameMode('classic');
                    ringTheBell();
