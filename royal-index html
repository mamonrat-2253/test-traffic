        // Initialize App on Window load
        window.onload = function() {
            updateTime();
            setInterval(updateTime, 60000);
            loadSaveData();
            renderDashboardState();

            // Handle press "Enter" inside tutor message field
            const chatInput = document.getElementById('aiTutorInput');
            if (chatInput) {
                chatInput.addEventListener('keypress', function(e) {
                    if (e.key === 'Enter') {
                        sendTutorMessage();
                    }
                });
            }
        };

        function updateTime() {
            const timeSpan = document.getElementById('statusBarTime');
            if (timeSpan) {
                const now = new Date();
                const h = String(now.getHours()).padStart(2, '0');
                const m = String(now.getMinutes()).padStart(2, '0');
                timeSpan.textContent = `${h}:${m}`;
            }
        }

        // Local Storage integration for gamification and progress persistence
        function saveProgress() {
            localStorage.setItem('royal_learn_app_save', JSON.stringify(AppState.progress));
            localStorage.setItem('royal_learn_app_stars', AppState.stars.toString());
            localStorage.setItem('royal_learn_app_images', JSON.stringify(AppState.savedImages));
        }

        function loadSaveData() {
            const progressRaw = localStorage.getItem('royal_learn_app_save');
            const starsRaw = localStorage.getItem('royal_learn_app_stars');
            const imagesRaw = localStorage.getItem('royal_learn_app_images');
            if (progressRaw) {
                try {
                    AppState.progress = JSON.parse(progressRaw);
                } catch(e) {
                    console.error("Save corrupted reset default");
                }
            }
            if (starsRaw) {
                AppState.stars = parseInt(starsRaw) || 0;
            }
            if (imagesRaw) {
                try {
                    AppState.savedImages = JSON.parse(imagesRaw);
                } catch(e) {
                    console.error("Image store read failed");
                }
            }
            document.getElementById('starCounter').textContent = AppState.stars;
        }

        // Add visual stars to top panel with pleasant notification
        function addStars(num) {
            AppState.stars += num;
            document.getElementById('starCounter').textContent = AppState.stars;
            saveProgress();
        }

        // Main Tab Switching Controller
        function switchTab(tabId) {
            // Hide all main section containers
            document.getElementById('viewLearn').classList.add('hidden');
            document.getElementById('viewChapterDetail').classList.add('hidden');
            document.getElementById('viewGame').classList.add('hidden');
            document.getElementById('viewQuiz').classList.add('hidden');
            document.getElementById('viewAiTutor').classList.add('hidden');
            document.getElementById('viewBadges').classList.add('hidden');

            // Reset tab navigation icons highlight
            const navIds = ['learn', 'game', 'quiz', 'aiTutor', 'badges'];
            navIds.forEach(id => {
                const navBtn = document.getElementById(`nav-${id}`);
                if (navBtn) {
                    navBtn.className = "flex flex-col items-center space-y-1 hover:text-thaiBlack transition-all duration-200 text-neutral-500";
                }
            });

            // Highlight Active Nav and Show Active container
            const activeNav = document.getElementById(`nav-${tabId}`);
            if (activeNav) {
                activeNav.className = "flex flex-col items-center space-y-1 text-royalGoldDark font-bold transition-all duration-200 scale-105";
            }

            if (tabId === 'learn') {
                document.getElementById('viewLearn').classList.remove('hidden');
                renderDashboardState();
            } else if (tabId === 'game') {
                document.getElementById('viewGame').classList.remove('hidden');
                resetGameBell();
            } else if (tabId === 'quiz') {
                document.getElementById('viewQuiz').classList.remove('hidden');
                // Only show screen matching current session status
                if (AppState.currentQuiz.active) {
                    document.getElementById('quizStartScreen').classList.add('hidden');
                    document.getElementById('quizPlayPanel').classList.remove('hidden');
                    document.getElementById('quizResultPanel').classList.add('hidden');
                } else {
                    document.getElementById('quizStartScreen').classList.remove('hidden');
                    document.getElementById('quizPlayPanel').classList.add('hidden');
                    document.getElementById('quizResultPanel').classList.add('hidden');
                }
            } else if (tabId === 'aiTutor') {
                document.getElementById('viewAiTutor').classList.remove('hidden');
                switchTutorSubTab('chat');
            } else if (tabId === 'badges') {
                document.getElementById('viewBadges').classList.remove('hidden');
                switchBadgesSubTab('badge');
            }

            // Smooth automatic scroll back to top of main frame
            document.getElementById('appMain').scrollTop = 0;
        }

