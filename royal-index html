        function switchTutorSubTab(subTab) {
            const chatBtn = document.getElementById('tutorSub-chat');
            const planBtn = document.getElementById('tutorSub-plan');
            const drawBtn = document.getElementById('tutorSub-draw');
            const chatPanel = document.getElementById('aiTutorChatPanel');
            const planPanel = document.getElementById('aiTutorPlanPanel');
            const drawPanel = document.getElementById('aiTutorDrawPanel');

