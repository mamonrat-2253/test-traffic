                const result = await response.json();
                const jsonText = result?.candidates?.[0]?.content?.parts?.[0]?.text;
                if (jsonText) {
                    const plan = JSON.parse(jsonText);
                    
                    // Populate AppState
                    AppState.currentPlan = plan;
                    AppState.currentPlan.active = true;

                    // Update UI elements
                    document.getElementById('planOutputTitle').textContent = plan.planTitle;
                    document.getElementById('planOutputAnalysis').textContent = plan.analysis;

                    const stepsContainer = document.getElementById('planOutputSteps');
                    let stepsHtml = '';
                    plan.steps.forEach((step, idx) => {
                        stepsHtml += `
                            <div class="flex items-start gap-2 text-xs font-formal">
                                <span class="w-5 h-5 flex-shrink-0 flex items-center justify-center bg-royalGoldLight border border-royalGold/30 rounded-full font-bold text-royalGoldDark text-[10px] mt-0.5">${idx + 1}</span>
                                <div>
                                    <strong class="text-thaiBlack font-traditional text-sm block">${step.title}</strong>
                                    <p class="text-neutral-600 text-[11px] leading-relaxed">${step.detail}</p>
                                </div>
                            </div>
                        `;
                    });
                    stepsContainer.innerHTML = stepsHtml;

                    // Enable/Reset action buttons
                    const drawBtn = document.getElementById('planDrawBtn');
                    const speakBtn = document.getElementById('planSpeakBtn');
                    drawBtn.innerHTML = `<i class="fa-solid fa-image text-royalGold"></i> สั่ง AI วาดแผนภาพ`;
                    drawBtn.disabled = false;
                    speakBtn.innerHTML = `<i class="fa-solid fa-volume-high text-royalGold"></i> 🔊 ฟังเสียงสรุปแผน`;
                    speakBtn.disabled = false;

                    addStars(50); // Reward for using planning feature

                    loader.classList.add('hidden');
                    outputBox.classList.remove('hidden');
                    document.getElementById('appMain').scrollTop = loader.offsetTop - 50;
                }
            } catch (e) {
                console.error("Failed to generate plan via Gemini API", e);
                loader.classList.add('hidden');
                const errorBox = document.createElement('div');
                errorBox.className = "bg-red-50 text-red-700 text-xs p-3 rounded-xl border border-red-300 font-formal text-center";
                errorBox.textContent = "การรังสรรค์แผนงานสะดุดล้มเนื่องจากสัญญาณอินเทอร์เน็ตไม่เอื้ออำนวย กรุณาลองใหม่อีกครั้งครับ";
                document.getElementById('aiTutorPlanPanel').prepend(errorBox);
                setTimeout(() => errorBox.remove(), 4000);
            }
        }

        async function triggerPlanDrawing() {
            if (!AppState.currentPlan.active || !AppState.currentPlan.imagePrompt) return;

            // Switch to the draw tab automatically
            switchTutorSubTab('draw');

            // Fill input with the AI-suggested prompt
            const promptInput = document.getElementById('aiDrawPromptInput');
            promptInput.value = AppState.currentPlan.imagePrompt;

            // Trigger drawing directly
            generateIllustration();
        }

        async function triggerPlanSpeaking() {
            if (!AppState.currentPlan.active || !AppState.currentPlan.audioSpeech) return;

            const speakBtn = document.getElementById('planSpeakBtn');
            speakText(speakBtn, AppState.currentPlan.audioSpeech);
        }

        const badgesConfig = [
            { id: "firstRead", title: "ผู้นอบน้อมเรียนรู้", icon: "fa-book-open", desc: "อ่านบทเรียนแรกสำเร็จเพื่อเริ่มเส้นทางปราชญ์" },
            { id: "gameBeaten", title: "ผู้ทรงวิสัยทัศน์", icon: "fa-bell", desc: "สั่นกระดิ่งทูลเกล้าและแก้ไขปัญหาฎีการาษฎรถูกต้องสำเร็จ" },
            { id: "quizPassed", title: "ผู้ผ่านการทดสอบ", icon: "fa-certificate", desc: "ผ่านแบบทดสอบอัจฉริยะ 20 ข้อด้วยคะแนน 15+" },
            { id: "perfectScore", title: "ราชบัณฑิตผู้ทรงเกียรติ", icon: "fa-crown", desc: "พิชิตแบบทดสอบอัจฉริยะ 20 ข้อเต็มอย่างไร้ที่ติ" }
        ];

        function renderBadgesView() {
            const container = document.getElementById('badgesContainer');
            let html = '';

            badgesConfig.forEach(badge => {
                const unlocked = AppState.progress.badges[badge.id];
                if (unlocked) {
                    html += `
                        <div class="bg-[#FDFBF7] border border-royalGold p-4 rounded-2xl text-center space-y-2 shadow-sm relative overflow-hidden group">
                            <div class="absolute -right-4 -bottom-4 text-royalGold/10 text-6xl pointer-events-none group-hover:scale-125 transition-transform duration-500">
                                <i class="fa-solid ${badge.icon}"></i>
                            </div>
                            <div class="w-12 h-12 mx-auto bg-white border border-royalGold rounded-full flex items-center justify-center text-royalGoldDark text-xl shadow-inner">
                                <i class="fa-solid ${badge.icon}"></i>
                            </div>
                            <h4 class="font-bold font-traditional text-sm leading-tight text-thaiBlack">${badge.title}</h4>
                            <p class="text-[10px] text-neutral-600 font-formal leading-snug">${badge.desc}</p>
                            <span class="inline-block text-[9px] bg-royalGoldLight border border-royalGold text-royalGoldDark font-bold font-traditional px-2 py-0.5 rounded-full uppercase tracking-wider">สำเร็จแล้ว</span>
                        </div>
                    `;
                } else {
                    html += `
                        <div class="bg-white p-4 rounded-2xl text-center space-y-2 border border-dashed border-neutral-300 opacity-60 shadow-sm">
                            <div class="w-12 h-12 mx-auto bg-neutral-100 rounded-full flex items-center justify-center text-neutral-400 text-xl">
                                <i class="fa-solid fa-lock"></i>
                            </div>
                            <h4 class="font-bold font-traditional text-sm leading-tight text-neutral-400">${badge.title}</h4>
                            <p class="text-[10px] text-neutral-400 font-formal leading-snug">${badge.desc}</p>
                            <span class="inline-block text-[9px] bg-neutral-100 text-neutral-400 font-bold font-traditional px-2 py-0.5 rounded-full uppercase tracking-wider">ยังไม่ปลดล็อก</span>
                        </div>
                    `;
                }
            });

            container.innerHTML = html;
        }

        function renderGalleryView() {
            const container = document.getElementById('savedImagesContainer');
            if (AppState.savedImages.length === 0) {
                container.innerHTML = `
                    <div class="col-span-2 text-center py-12 text-neutral-400 space-y-2 select-none">
                        <i class="fa-solid fa-folder-open text-4xl block text-royalGold"></i>
                        <p class="text-xs font-traditional">ยังไม่มีภาพวาดสะสม ย้ายไปแท็บ AI ติวเตอร์ เพื่อสร้างและส่งภาพวาดโครงการหลวงเข้ามาที่นี่ได้เลยครับ</p>
                    </div>
                `;
                return;
            }

            let html = '';
            AppState.savedImages.forEach((imgUrl, idx) => {
                html += `
                    <div class="bg-white border border-royalGold/30 rounded-2xl overflow-hidden p-2 flex flex-col space-y-1.5 shadow-sm relative group">
                        <img src="${imgUrl}" alt="Saved Art" class="w-full h-24 object-cover rounded-xl border border-royalGold shadow-inner">
                        <div class="flex justify-between items-center px-1">
                            <span class="text-[10px] font-bold font-traditional text-neutral-500">ชิ้นที่ ${idx + 1}</span>
                            <button onclick="deleteImage(${idx})" class="text-xs text-neutral-400 hover:text-red-500 transition-colors">
                                <i class="fa-regular fa-trash-can"></i>
                            </button>
                        </div>
                    </div>
                `;
            });
            container.innerHTML = html;
        }

        function deleteImage(index) {
            AppState.savedImages.splice(index, 1);
            saveProgress();
            renderGalleryView();
        }

    </script>
</body>
</html>
