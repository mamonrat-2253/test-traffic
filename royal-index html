        function startQuizNow() {
            const shuffled = [...quizBank].sort(() => 0.5 - Math.random());
            AppState.currentQuiz.questions = shuffled.slice(0, 20);
            AppState.currentQuiz.currentIndex = 0;
            AppState.currentQuiz.score = 0;
            AppState.currentQuiz.answers = [];
            AppState.currentQuiz.active = true;
            AppState.currentQuiz.isAiQuiz = false;

            document.getElementById('quizStartScreen').classList.add('hidden');
            document.getElementById('quizPlayPanel').classList.remove('hidden');
            document.getElementById('quizResultPanel').classList.add('hidden');
            document.getElementById('quizLoadingState').classList.add('hidden');
            document.getElementById('quizQuestionContainer').classList.remove('hidden');
            
            document.getElementById('quizModeLabel').textContent = "ปกติ";
            document.getElementById('totalQuestionsLimit').textContent = "20";

            renderQuizQuestion();
        }

        function showAiQuizGeneratorSetup() {
            const setupArea = document.getElementById('aiQuizSetupArea');
            setupArea.classList.toggle('hidden');
        }

        // Use gemini-3-flash-preview to generate structured JSON quiz dynamically
        async function generateCustomAiQuiz() {
            const topicInput = document.getElementById('aiQuizTopicInput');
            const topic = topicInput.value.trim();
            if (!topic) return;

            document.getElementById('quizStartScreen').classList.add('hidden');
            document.getElementById('quizPlayPanel').classList.remove('hidden');
            document.getElementById('quizLoadingState').classList.remove('hidden');
            document.getElementById('quizQuestionContainer').classList.add('hidden');
            document.getElementById('quizResultPanel').classList.add('hidden');

            const systemPrompt = `คุณคือระบบสร้างข้อสอบประวัติศาสตร์ไทยและศาสตร์พระราชาคุณภาพสูง คุณต้องสร้างข้อสอบปรนัยจำนวน 5 ข้อ เกี่ยวกับหัวข้อที่ผู้ใช้ระบุ คืนค่ามาเป็นรูปแบบโครงสร้างข้อมูล JSON เสมอตาม Schema ที่ระบุ โดยแต่ละข้อต้องมีตัวเลือก 4 ข้อ และเฉลยตัวเลือกที่ถูกต้องด้วยดัชนี (0, 1, 2, 3)`;
            const userQuery = `โปรดสร้างข้อสอบแบบปรนัยจำนวน 5 ข้อ เรื่อง: "${topic}" ที่มีความท้าทาย น่ารู้ และถูกต้องตามวิชาการ`;

            const apiKey = "";
            const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=${apiKey}`;

            const payload = {
                contents: [{ parts: [{ text: userQuery }] }],
                systemInstruction: {
                    parts: [{ text: systemPrompt }]
                },
                generationConfig: {
                    responseMimeType: "application/json",
                    responseSchema: {
                        type: "ARRAY",
                        items: {
                            type: "OBJECT",
                            properties: {
                                q: { type: "STRING", description: "คำถามข้อสอบ" },
                                a: {
                                    type: "ARRAY",
                                    items: { type: "STRING" },
                                    description: "ตัวเลือกคำตอบ 4 ตัวเลือก"
                                },
                                c: { type: "INTEGER", description: "ดัชนีตัวเลือกที่ถูกต้องตั้งแต่ 0 ถึง 3" }
                            },
                            required: ["q", "a", "c"]
                        }
                    }
                }
            };

            // Implement exponential backoff for custom quiz generating calls
            let delay = 1000;
            for (let attempt = 0; attempt < 3; attempt++) {
                try {
                    const response = await fetch(apiUrl, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });
                    
                    if (response.ok) {
                        const result = await response.json();
                        const jsonText = result?.candidates?.[0]?.content?.parts?.[0]?.text;
                        if (jsonText) {
                            const generatedQuestions = JSON.parse(jsonText);
                            if (generatedQuestions && generatedQuestions.length > 0) {
                                AppState.currentQuiz.questions = generatedQuestions;
                                AppState.currentQuiz.currentIndex = 0;
                                AppState.currentQuiz.score = 0;
                                AppState.currentQuiz.answers = [];
                                AppState.currentQuiz.active = true;
                                AppState.currentQuiz.isAiQuiz = true;

                                document.getElementById('quizLoadingState').classList.add('hidden');
                                document.getElementById('quizQuestionContainer').classList.remove('hidden');
                                document.getElementById('quizModeLabel').textContent = "AI พิเศษ";
                                document.getElementById('totalQuestionsLimit').textContent = generatedQuestions.length.toString();

                                renderQuizQuestion();
                                return;
                            }
                        }
                    } else if (response.status === 429) {
                        await new Promise(resolve => setTimeout(resolve, delay));
                        delay *= 2;
                    }
                } catch(e) {
                    await new Promise(resolve => setTimeout(resolve, delay));
                    delay *= 2;
                }
            }

            // Fallback in case of API failure
            startQuizNow();
        }

        function renderQuizQuestion() {
            const qIndex = AppState.currentQuiz.currentIndex;
            const qData = AppState.currentQuiz.questions[qIndex];
            if (!qData) return;

            document.getElementById('currentQuestionNumber').textContent = qIndex + 1;
            document.getElementById('liveScore').textContent = `${AppState.currentQuiz.score}/${qIndex}`;
            document.getElementById('quizQuestionText').textContent = qData.q;

            const answersBox = document.getElementById('quizAnswersBox');
            let html = '';
            qData.a.forEach((ans, idx) => {
                html += `
                    <button onclick="selectQuizAnswer(${idx})" class="w-full text-left bg-white hover:bg-royalGoldLight border border-royalGold/30 rounded-2xl p-4 text-xs font-formal text-thaiBlack transition-all active:scale-95 duration-150 shadow-sm hover:shadow-md flex items-center">
                        <span class="w-6 h-6 inline-flex items-center justify-center bg-royalGoldLight border border-royalGold/30 rounded-full text-xs font-bold text-royalGoldDark mr-2.5">${String.fromCharCode(65 + idx)}</span>
                        <span>${ans}</span>
                    </button>
                `;
            });
            answersBox.innerHTML = html;
        }

        function selectQuizAnswer(selectedIdx) {
            const qIndex = AppState.currentQuiz.currentIndex;
            const qData = AppState.currentQuiz.questions[qIndex];
            const totalQuestions = AppState.currentQuiz.questions.length;

            const isCorrect = (selectedIdx === qData.c);
            if (isCorrect) {
                AppState.currentQuiz.score++;
            }

            AppState.currentQuiz.answers.push({
                question: qData.q,
                selected: selectedIdx,
                correct: qData.c,
                wasCorrect: isCorrect
            });

            if (qIndex + 1 < totalQuestions) {
                AppState.currentQuiz.currentIndex++;
                renderQuizQuestion();
            } else {
                finishQuizSession();
            }
        }

        function finishQuizSession() {
            AppState.currentQuiz.active = false;
            const finalScore = AppState.currentQuiz.score;
            const totalQuestions = AppState.currentQuiz.questions.length;
            const targetRatio = AppState.currentQuiz.isAiQuiz ? 0.6 : 0.75; // 3/5 for AI, 15/20 for Static
            const passed = (finalScore / totalQuestions) >= targetRatio;

            document.getElementById('quizPlayPanel').classList.add('hidden');
            document.getElementById('quizResultPanel').classList.remove('hidden');

