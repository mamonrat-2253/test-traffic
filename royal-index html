                if (!AppState.progress.badges.gameBeaten) {
                    AppState.progress.badges.gameBeaten = true;
                    addStars(30);
                    saveProgress();
                }
            } else {
                feedbackIcon.className = "text-5xl text-neutral-800";
                feedbackIcon.innerHTML = '<i class="fa-solid fa-triangle-exclamation"></i>';
                feedbackTitle.textContent = "ยังไม่สามารถบรรเทาทุกข์ภัย...";
                feedbackTitle.className = "text-xl font-bold font-traditional text-neutral-800";
                feedbackDesc.textContent = feedbackText;
            }
        }

