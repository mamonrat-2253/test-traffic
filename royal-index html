        // Synthesize metallic bell ring using pure Web Audio API (extremely robust, zero dependency)
        function playSynthesizedBell() {
            try {
                const AudioContext = window.AudioContext || window.webkitAudioContext;
                if (!AudioContext) return;
                const ctx = new AudioContext();
                const now = ctx.currentTime;
                
                const freqs = [587.33, 880.00, 1174.66, 1760.00]; // D5, A5, D6, A6 harmonics
                freqs.forEach((f, i) => {
                    const osc = ctx.createOscillator();
                    const gain = ctx.createGain();
                    
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(f, now);
                    
                    gain.gain.setValueAtTime(i === 0 ? 0.25 : 0.08, now);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + 1.2);
                    
                    osc.connect(gain);
                    gain.connect(ctx.destination);
                    
                    osc.start(now);
                    osc.stop(now + 1.3);
                });
            } catch(e) {
                console.warn("Audio Context init blocked or unsupported on this device browser", e);
            }
        }

